<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Глобальный перехват клавиш требует выхода из sandbox; распространение
	     вне App Store с Developer ID + нотаризацией (Приложение A ТЗ). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Hardened runtime: проверка подписи библиотек остаётся включённой. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<false/>

	<!-- iCloud KVS здесь намеренно нет: это ограниченное entitlement, без
	     встроенного provisioning profile приложение не запустится. Сборка
	     с синхронизацией использует SmartSwitcher-iCloud.entitlements. -->
</dict>
</plist>
